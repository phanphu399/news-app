# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase Cloud Messaging (HTTP v1)
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"
# Optional legacy fallback (deprecated; prefer OAuth2 service account above)
FCM_SERVER_KEY=

# Optional auth for the cron endpoint
CRON_SECRET=your-long-random-secret

# Optional custom topic
FCM_TOPIC=market_alerts