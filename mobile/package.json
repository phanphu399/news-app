{
  "name": "news-app-mobile",
  "version": "1.0.0",
  "description": "Realtime Forex & Macro News mobile app (Expo / React Native) with Supabase Realtime, FCM alerts and TradingView calendar",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "build": "expo export --platform web && node scripts/build-web.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.45.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.21",
    "expo-asset": "~57.0.16",
    "expo-dev-client": "~57.0.18",
    "expo-linear-gradient": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "fast-xml-parser": "^4.5.0",
    "lucide-react-native": "^1.43.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@expo/ngrok": "^4.1.3"
  }
}
